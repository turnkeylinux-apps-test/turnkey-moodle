#!/bin/bash -ex
# main by Daniele Lolli (UncleDan) feat. Claude AI - Release 19.0 - 2026-11-10 17-04-47
#
# Moodle source code is obtained from Git as per "Git for Administrators":
# https://docs.moodle.org/en/Git_for_Administrators

# installation paths: everything below refers to these variables only
MOODLE_PATH=/var/www/moodle
MOODLE_DATA_PATH=/var/moodledata

DB_NAME=moodle
DB_USER=moodle
DB_PASS=$(mcookie)

ADMIN_USER="admin"
ADMIN_PASS=turnkey
# Moodle stable branch to install and track
# (list: https://github.com/moodle/moodle/branches).
# The Moodle version (major.minor) is derived from the branch name:
# MOODLE_503_STABLE => 5.3, MOODLE_405_STABLE => 4.5, MOODLE_39_STABLE => 3.9
#
# To install an exact release (a tag) instead of the latest commit of the
# branch, use the same structure as the moodle405up-beta appliance:
#   1. replace the MOODLE_BRANCH and MOODLE_VERSION lines with the tag:
#        MOODLE_VERSION=5.3.1      # a tag at https://github.com/moodle/moodle/tags, without "v"
#        MOODLE_TAG="v${MOODLE_VERSION}"
#      keep MOODLE_MAJOR / MOODLE_MINOR, and derive the branch from the version
#      instead of checking it, replacing the 'test "$MOODLE_BRANCH_EXPECTED" ...'
#      line with:
#        MOODLE_BRANCH=$MOODLE_BRANCH_EXPECTED
#      (5.3.1 => MOODLE_503_STABLE, 4.0.5 => MOODLE_400_STABLE, 3.9.25 => MOODLE_39_STABLE)
#   2. after "git checkout", pin the local branch to the tag (the branch still
#      tracks origin, so a later "git pull" upgrades within the branch):
#        git merge-base --is-ancestor "$MOODLE_TAG" "origin/$MOODLE_BRANCH"
#        git reset --hard "$MOODLE_TAG"
#        test "$(git rev-parse HEAD)" = "$(git rev-parse "${MOODLE_TAG}^{commit}")"
#      and drop the "HEAD = origin/$MOODLE_BRANCH" check, which no longer holds
#   3. add MOODLE_TAG=$MOODLE_TAG to /etc/turnkey-moodle-release
MOODLE_BRANCH=MOODLE_503_STABLE
MOODLE_VERSION=$(sed -nE 's/^MOODLE_([0-9])([0-9])_STABLE$/\1.\2/p; s/^MOODLE_([0-9])0?([0-9]{1,2})_STABLE$/\1.\2/p' <<<"$MOODLE_BRANCH")
MOODLE_MAJOR=${MOODLE_VERSION%%.*}
MOODLE_MINOR=${MOODLE_VERSION#*.}; MOODLE_MINOR=${MOODLE_MINOR%%.*}
if [ -z "$MOODLE_VERSION" ]; then
    echo "FATAL: $MOODLE_BRANCH is not a MOODLE_xxx_STABLE branch name" >&2
    exit 1
fi
# check: the branch name rebuilt from the version must match MOODLE_BRANCH
if [ "$MOODLE_MAJOR" -ge 4 ]; then
    MOODLE_BRANCH_EXPECTED=$(printf 'MOODLE_%d%02d_STABLE' "$MOODLE_MAJOR" "$MOODLE_MINOR")
else
    MOODLE_BRANCH_EXPECTED="MOODLE_${MOODLE_MAJOR}${MOODLE_MINOR}_STABLE"
fi
test "$MOODLE_BRANCH_EXPECTED" = "$MOODLE_BRANCH"
# value of $branch in version.php (MOODLE_503_STABLE => '503')
MOODLE_BRANCH_NUM=${MOODLE_BRANCH//[!0-9]/}
echo "Moodle branch $MOODLE_BRANCH => version $MOODLE_VERSION"

# Moodle < 5.1 has no "public/" directory: Apache must serve the webroot
if dpkg --compare-versions "$MOODLE_VERSION" lt "5.1~"; then
    sed -i "s|$MOODLE_PATH/public/|$MOODLE_PATH/|g" \
        /etc/apache2/sites-available/moodle.conf
fi

# start mysql
systemctl start mysql

# create database
mysqladmin --skip-ssl create $DB_NAME

# create database user with privileges on the database
MYSQL_BATCH="mysql --skip-ssl --batch --execute"
$MYSQL_BATCH "grant all privileges on $DB_NAME.* to $DB_USER@localhost identified by '$DB_PASS';"
$MYSQL_BATCH "flush privileges;"

# setup apache configuration and complete installation
a2dissite 000-default
a2ensite moodle
a2enmod rewrite
a2enmod headers

# get the code from Git exactly as per Moodle docs
# https://docs.moodle.org/en/Git_for_Administrators
# NOTE: git.moodle.org is retiring anonymous git:// access and asks to clone
# the official GitHub repository instead, which is used here over HTTPS
# abort the build if MOODLE_PATH already exists, then clone into it
if [ -e "$MOODLE_PATH" ]; then
    echo "FATAL: $MOODLE_PATH already exists" >&2
    exit 1
fi
git clone https://github.com/moodle/moodle.git "$MOODLE_PATH"
cd "$MOODLE_PATH"
# --no-pager: on a terminal "git branch" would wait in the pager (less)
git --no-pager branch -a
git branch --track "$MOODLE_BRANCH" "origin/$MOODLE_BRANCH"
git checkout "$MOODLE_BRANCH"
MOODLE_COMMIT=$(git rev-parse HEAD)
# checks: HEAD is the latest commit of the branch, the local branch tracks
# origin, and version.php belongs to the same branch and version
test "$MOODLE_COMMIT" = "$(git rev-parse "origin/$MOODLE_BRANCH")"
test "$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}')" = "origin/$MOODLE_BRANCH"
# version.php is in public/ from Moodle 5.1
MOODLE_VERSION_PHP=version.php
[ -f public/version.php ] && MOODLE_VERSION_PHP=public/version.php
grep -Eq "^\\\$branch *= *'${MOODLE_BRANCH_NUM}';" "$MOODLE_VERSION_PHP"
grep -Eq "^\\\$release *= *'${MOODLE_VERSION//./\\.}[.+ ]" "$MOODLE_VERSION_PHP"
echo "Moodle $MOODLE_BRANCH => commit $MOODLE_COMMIT," \
    "release $(sed -nE "s/^\\\$release *= *'([^']*)'.*/\1/p" "$MOODLE_VERSION_PHP")"

# record the installed branch/commit, so it can be checked later (e.g. by tests)
cat > /etc/turnkey-moodle-release <<EOF
MOODLE_PATH=$MOODLE_PATH
MOODLE_DATA_PATH=$MOODLE_DATA_PATH
MOODLE_BRANCH=$MOODLE_BRANCH
MOODLE_VERSION=$MOODLE_VERSION
MOODLE_COMMIT=$MOODLE_COMMIT
EOF

cd "$MOODLE_PATH"
php admin/cli/install.php \
    --chmod=750 \
    --lang=en \
    --wwwroot="http://127.0.0.1" \
    --dataroot=$MOODLE_DATA_PATH \
    --dbtype=mariadb \
    --dbhost=localhost \
    --dbname=$DB_NAME \
    --dbuser=$DB_USER \
    --dbpass="$DB_PASS" \
    --prefix="" \
    --fullname="TurnKey Moodle" \
    --shortname=moodle \
    --adminuser=$ADMIN_USER \
    --adminpass=$ADMIN_PASS \
    --adminemail=admin@example.com \
    --upgradekey= \
    --non-interactive \
    --agree-license

# Executable Moodle and theme/plugin code is root-owned. Only Moodle's data
# directory remains writable by the web service.
chown -R root:root "$MOODLE_PATH"
find "$MOODLE_PATH" -type d -exec chmod 0755 {} +
find "$MOODLE_PATH" -type f -exec chmod 0644 {} +
chown root:www-data "$MOODLE_PATH/config.php"
chmod 0640 "$MOODLE_PATH/config.php"
chown -R www-data:www-data "$MOODLE_DATA_PATH"
find "$MOODLE_DATA_PATH" -type d -exec chmod 0750 {} +
find "$MOODLE_DATA_PATH" -type f -exec chmod 0640 {} +

## tweak config

# configure moodle to use dynamic hostname and ssl (webroot)
sed -i "s|\$CFG->wwwroot \(.*\)|\$protocol='http://';\n\$hostname='127.0.0.1';\nif (isset(\$_SERVER['HTTPS'])) { \$protocol='https://'; }\nif (isset(\$_SERVER['HTTP_HOST'])) { \$hostname=\$_SERVER['HTTP_HOST']; }\n\$CFG->wwwroot = \$protocol.\$hostname;\n|" $MOODLE_PATH/config.php

# prevent setting of executable paths via Admin UI (locks down possible privilege escalation)
sed -i "/'admin';$/ a \$CFG->preventexecpath = true;" $MOODLE_PATH/config.php

# set paths to utils
mysql --skip-ssl <<EOF
USE $DB_NAME;
UPDATE config SET value = '1' WHERE name = 'loginhttps';
UPDATE config SET value = '127.0.0.1' WHERE name = 'smtphosts';
UPDATE config SET value = 'noreply@example.com' WHERE name = 'noreplyaddress';
UPDATE config SET value = '/usr/bin/du' WHERE name = 'pathtodu';
UPDATE config SET value = '/usr/bin/aspell' WHERE name = 'aspellpath';
UPDATE config SET value = '/usr/bin/php' WHERE name = 'pathtophp';
UPDATE config SET value = '/usr/bin/dot' WHERE name = 'pathtodot';
UPDATE config SET value = '/usr/bin/gs' WHERE name = 'pathtogs';
UPDATE config SET value = '/usr/bin/pdftoppm' WHERE name = 'pathtopdftoppm';
UPDATE config SET value = '/usr/bin/python3' WHERE name = 'pathtopython';
EOF

# Moodle 5.2 does not seed noreplyaddress, so an UPDATE alone is a no-op.
# Use Moodle's configuration API to create it and invalidate its cache.
runuser -u www-data -- php admin/cli/cfg.php \
    --name=noreplyaddress --set=noreply@example.com

# disable user delete - removes hyped up "critical" warning
# - see https://tracker.moodle.org/browse/MDL-67852 for more info
mysql --skip-ssl <<EOF
USE $DB_NAME;
DELETE FROM role_capabilities WHERE capability = "tool/dataprivacy:requestdelete";
EOF

# stop mysql server
systemctl stop  mysql

# Harden permissions to production level "--harden".
# In this mode, you cannot install plugins from the Moodle graphical interface,
# but you have bullet proof permissions.
# If you want to stay with “--semi-harden” to be able to install plugins
# from the graphical interface, simply change the line below.
tkl-set-moodle-perms --harden -mp "$MOODLE_PATH" -md "$MOODLE_DATA_PATH"
